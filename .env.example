# SoulSpace Environment Variables Example
# Copy or set in your environment:
PORT=8090
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Optional Database (defaults to local H2 at ./data/soulspace)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/soulspace
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=password
